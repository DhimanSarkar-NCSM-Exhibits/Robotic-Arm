// -------------------------------------------------------
// Historical and Foundational Papers
// (accessible and significant)
// -------------------------------------------------------

@article{Denavit1955,
  author  = {Jacques Denavit and Richard S. Hartenberg},
  title   = {A Kinematic Notation for Lower-Pair Mechanisms Based on Matrices},
  journal = {Journal of Applied Mechanics},
  year    = {1955},
  volume  = {22},
  pages   = {215--221},
  note    = {The paper that introduced the Denavit-Hartenberg (DH) convention — the universal notation for describing robot joint geometry used in every robotics textbook and robot controller in the world.}
}

@article{Whitney1969,
  author  = {Daniel E. Whitney},
  title   = {Resolved Motion Rate Control of Manipulators and Human Prostheses},
  journal = {IEEE Transactions on Man-Machine Systems},
  year    = {1969},
  volume  = {10},
  number  = {2},
  pages   = {47--53},
  doi     = {10.1109/TMMS.1969.299896},
  note    = {MIT. Introduced the Jacobian-based velocity control method for robot arms. One of the most consequential single ideas in the history of robot control, still used in every modern robot controller.}
}

@article{Engelberger1980,
  title     = {Robotics in Practice: Management and Applications of Industrial Robots},
  author    = {Joseph F. Engelberger},
  year      = {1980},
  publisher = {AMACOM},
  isbn      = {978-0-814-45356-0},
  note      = {Written by the Father of Industrial Robotics, who commercialised the first industrial robot arm (Unimate) in the 1960s. A first-hand account of the birth of the robotics industry.}
}

@article{Rus2015,
  author  = {Daniela Rus and Michael T. Tolley},
  title   = {Design, Fabrication and Control of Soft Robots},
  journal = {Nature},
  year    = {2015},
  volume  = {521},
  pages   = {467--475},
  doi     = {10.1038/nature14543},
  url     = {https://www.nature.com/articles/nature14543},
  note    = {MIT CSAIL. An accessible and well-illustrated overview of soft robotics — robots built from flexible, compliant materials inspired by living organisms. Published in Nature, freely readable online.}
}

@article{Mnih2015,
  author  = {Volodymyr Mnih and Koray Kavukcuoglu and David Silver and others},
  title   = {Human-Level Control Through Deep Reinforcement Learning},
  journal = {Nature},
  year    = {2015},
  volume  = {518},
  pages   = {529--533},
  doi     = {10.1038/nature14236},
  url     = {https://www.nature.com/articles/nature14236},
  note    = {DeepMind. The landmark paper that launched the modern era of deep reinforcement learning. The same ideas now underpin how robots learn locomotion and manipulation tasks without explicit programming. Freely readable online.}
}